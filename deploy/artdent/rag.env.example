# JWT_SECRET must match app.env.
JWT_SECRET=REPLACE_WITH_SHARED_APP_JWT_SECRET
RAG_OPENAI_API_KEY=REPLACE_WITH_OPENROUTER_KEY
RAG_OPENAI_BASEURL=https://openrouter.ai/api/v1
RAG_OPENAI_PROXY=http://PROXY_IP:8888
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=openai/text-embedding-3-small
EMBEDDINGS_CHUNK_SIZE=50
